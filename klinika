# КЛАСС: Услуга (Service)
# ============================================================

class Service(BaseEntity):
    """Класс стоматологической услуги"""

    def __init__(self, entity_id: int, name: str, price: float, duration: int):
        super().__init__(entity_id)
        self._name = name
        self._price = price
        self._duration = duration  # в минутах

    # ---- Геттеры и сеттеры ----
    @property
    def name(self):
        return self._name

    @name.setter
    def name(self, value):
        self._name = value

    @property
    def price(self):
        return self._price

    @price.setter
    def price(self, value):
        if value < 0:
            raise ValueError("Цена не может быть отрицательной")
        self._price = value

    @property
    def duration(self):
        return self._duration

    @duration.setter
    def duration(self, value):
        self._duration = value

    # ---- Специальные методы ----
    def __eq__(self, other):
        if not isinstance(other, Service):
            return NotImplemented
        return self._name == other._name

    def __hash__(self):
        return hash(self._name)

    def __repr__(self):
        return f"Service(name={self._name!r}, price={self._price})"

    def __str__(self):
        return f"{self._name} — {self._price:.2f} руб. ({self._duration} мин)"

    def __lt__(self, other):
        if not isinstance(other, Service):
            return NotImplemented
        return self._price < other._price

    def __add__(self, other):
        if not isinstance(other, Service):
            return NotImplemented
        return self._price + other._price

    # ---- Реализация абстрактных методов ----
    def get_info(self) -> str:
        return f"{self._name} | {self._price:.2f} руб. | {self._duration} мин"

    def to_dict(self) -> dict:
        return {
            "id": self._id,
            "name": self._name,
            "price": self._price,
            "duration": self._duration,
        }

    # ---- Методы класса ----
    @staticmethod
    def apply_discount(price: float, discount_percent: float) -> float:
        return round(price * (1 - discount_percent / 100), 2)


