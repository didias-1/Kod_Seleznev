    # ---- Обновление таблиц ----
    def _refresh_doctors(self):
        for row in self._doctors_tree.get_children():
            self._doctors_tree.delete(row)
        spec = self._spec_var.get()
        for d in self._doctors:
            if spec != "Все" and d.specialization != spec:
                continue
            self._doctors_tree.insert("", tk.END, values=(
                d.entity_id, d.full_name, d.specialization, d.experience, d.cabinet
            ))

    def _refresh_patients(self):
        for row in self._patients_tree.get_children():
            self._patients_tree.delete(row)
        diag = self._diag_var.get()
        min_age = self._get_int(self._min_age_entry.get())
        max_age = self._get_int(self._max_age_entry.get())
        for p in self._patients:
            if diag != "Все" and p.diagnosis != diag:
                continue
            if min_age is not None and p.age < min_age:
                continue
            if max_age is not None and p.age > max_age:
                continue
            self._patients_tree.insert("", tk.END, values=(
                p.entity_id, p.full_name, p.phone, p.age, p.diagnosis
            ))

    def _refresh_services(self):
        for row in self._services_tree.get_children():
            self._services_tree.delete(row)
        for s in self._services:
            self._services_tree.insert("", tk.END, values=(
                s.entity_id, s.name, f"{s.price:.2f}", s.duration
            ))

    # ---- Сброс фильтров ----
    def _reset_doctors_filter(self):
        self._spec_var.set("Все")
        self._refresh_doctors()

    def _reset_patients_filter(self):
        self._diag_var.set("Все")
        self._min_age_entry.delete(0, tk.END)
        self._max_age_entry.delete(0, tk.END)
        self._refresh_patients()

    # ---- Статистика ----
    def _update_stats(self):
        total_services_cost = sum(s.price for s in self._services)
        self._stats_label.config(
            text=f"Врачей: {len(self._doctors)} | Пациентов: {len(self._patients)} | "
                 f"Услуг: {len(self._services)} | Суммарная стоимость услуг: {total_services_cost:.2f} руб."
        )

    # ---- Вспомогательные методы ----
    @staticmethod
    def _get_int(text: str):
        try:
            return int(text)
        except (ValueError, TypeError):
            return None

    # ---- Авторизация ----
    def _login(self):
        login = self._login_entry.get().strip()
        password = self._password_entry.get().strip()

        # Тестовые учётные записи
        valid_users = {
            "admin": ("admin123", "admin"),
            "doctor": ("doctor123", "doctor"),
            "registrator": ("reg123", "registrator"),
        }

        if login in valid_users and valid_users[login][0] == password:
            self._current_user = login
            self._status_label.config(
                text=f"Авторизован: {login} | Роль: {valid_users[login][1]}",
                fg="#27ae60"
            )
            self._login_btn.config(state=tk.DISABLED)
            self._logout_btn.config(state=tk.NORMAL)
            self._login_entry.delete(0, tk.END)
            self._password_entry.delete(0, tk.END)
            messagebox.showinfo("Успех", f"Добро пожаловать, {login}!")
        else:
            messagebox.showerror("Ошибка", "Неверный логин или пароль!")

    def _logout(self):
        self._current_user = None
        self._status_label.config(text="Не авторизован", fg="#7f8c8d")
        self._login_btn.config(state=tk.NORMAL)
        self._logout_btn.config(state=tk.DISABLED)

    # ---- Центрирование окна ----
    def _center_window(self):
        self.update_idletasks()
        w, h = self.winfo_width(), self.winfo_height()
        sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
        x, y = (sw - w) // 2, (sh - h) // 2
        self.geometry(f"{w}x{h}+{x}+{y}")

    # ---- Сохранение отчёта ----
    def _on_close(self):
        fmt = "%d.%m.%Y %H:%M:%S"
        now = datetime.now().strftime(fmt)

        try:
            with open("report.txt", "w", encoding="utf-8") as f:
                f.write("+----------------------------------------------------------+\n")
                f.write("| login        | time_in              | time_out              |\n")
                f.write("|--------------|----------------------|-----------------------|\n")
                f.write(f"| {'admin':<12} | {now:<20} | {now:<21} |\n")
                f.write(f"| {'doctor':<12} | {now:<20} | {now:<21} |\n")
                f.write(f"| {'registrator':<12} | {now:<20} | {now:<21} |\n")
                f.write("+----------------------------------------------------------+\n")
                f.write(f"\nВсего врачей: {len(self._doctors)}\n")
                f.write(f"Всего пациентов: {len(self._patients)}\n")
                f.write(f"Всего услуг: {len(self._services)}\n")
        except Exception as e:
            print(f"Ошибка сохранения отчёта: {e}")

        self.destroy()


