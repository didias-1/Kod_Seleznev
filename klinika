# ============================================================
# АБСТРАКТНЫЙ БАЗОВЫЙ КЛАСС
# ============================================================

class BaseEntity(ABC):
    """Абстрактный базовый класс для всех сущностей клиники"""

    def __init__(self, entity_id: int):
        self._id = entity_id

    @property
    def entity_id(self):
        return self._id

    @entity_id.setter
    def entity_id(self, value):
        self._id = value

    @abstractmethod
    def get_info(self) -> str:
        pass

    @abstractmethod
    def to_dict(self) -> dict:
        pass

    def __eq__(self, other):
        if not isinstance(other, BaseEntity):
            return NotImplemented
        return self._id == other._id

    def __hash__(self):
        return hash(self._id)

    def __repr__(self):
        return f"{self.__class__.__name__}(id={self._id})"

    def __str__(self):
        return self.get_info()


# ============================================================
# КЛАСС: Врач (Dentist)
# ============================================================

class Dentist(BaseEntity):
    """Класс врача-стоматолога"""

    def __init__(self, entity_id: int, full_name: str, specialization: str,
                 experience: int, cabinet: str):
        super().__init__(entity_id)
        self._full_name = full_name
        self._specialization = specialization
        self._experience = experience
        self._cabinet = cabinet

    # ---- Геттеры и сеттеры ----
    @property
    def full_name(self):
        return self._full_name

    @full_name.setter
    def full_name(self, value):
        self._full_name = value

    @property
    def specialization(self):
        return self._specialization

    @specialization.setter
    def specialization(self, value):
        self._specialization = value

    @property
    def experience(self):
        return self._experience

    @experience.setter
    def experience(self, value):
        if value < 0:
            raise ValueError("Опыт не может быть отрицательным")
        self._experience = value

    @property
    def cabinet(self):
        return self._cabinet

    @cabinet.setter
    def cabinet(self, value):
        self._cabinet = value

    # ---- Специальные методы ----
    def __eq__(self, other):
        if not isinstance(other, Dentist):
            return NotImplemented
        return self._full_name == other._full_name

    def __hash__(self):
        return hash(self._full_name)

    def __repr__(self):
        return f"Dentist(name={self._full_name!r}, spec={self._specialization!r})"

    def __str__(self):
        return f"Врач: {self._full_name} | {self._specialization} | Стаж: {self._experience} лет"

    def __lt__(self, other):
        if not isinstance(other, Dentist):
            return NotImplemented
        return self._experience < other._experience

    # ---- Реализация абстрактных методов ----
    def get_info(self) -> str:
        return f"{self._full_name} — {self._specialization} (каб. {self._cabinet})"

    def to_dict(self) -> dict:
        return {
            "id": self._id,
            "full_name": self._full_name,
            "specialization": self._specialization,
            "experience": self._experience,
            "cabinet": self._cabinet,
        }

    # ---- Методы класса ----
    @staticmethod
    def validate_name(name: str) -> bool:
        return len(name.strip()) >= 3


