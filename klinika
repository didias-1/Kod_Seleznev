# КЛАСС: Пациент (Patient)
# ============================================================

class Patient(BaseEntity):
    """Класс пациента стоматологической клиники"""

    def __init__(self, entity_id: int, full_name: str, phone: str,
                 age: int, diagnosis: str):
        super().__init__(entity_id)
        self._full_name = full_name
        self._phone = phone
        self._age = age
        self._diagnosis = diagnosis

    # ---- Геттеры и сеттеры ----
    @property
    def full_name(self):
        return self._full_name

    @full_name.setter
    def full_name(self, value):
        self._full_name = value

    @property
    def phone(self):
        return self._phone

    @phone.setter
    def phone(self, value):
        self._phone = value

    @property
    def age(self):
        return self._age

    @age.setter
    def age(self, value):
        if value < 0 or value > 120:
            raise ValueError("Некорректный возраст")
        self._age = value

    @property
    def diagnosis(self):
        return self._diagnosis

    @diagnosis.setter
    def diagnosis(self, value):
        self._diagnosis = value

    # ---- Специальные методы ----
    def __eq__(self, other):
        if not isinstance(other, Patient):
            return NotImplemented
        return self._full_name == other._full_name and self._phone == other._phone

    def __hash__(self):
        return hash((self._full_name, self._phone))

    def __repr__(self):
        return f"Patient(name={self._full_name!r}, age={self._age})"

    def __str__(self):
        return f"Пациент: {self._full_name}, {self._age} лет, тел. {self._phone}"

    def __lt__(self, other):
        if not isinstance(other, Patient):
            return NotImplemented
        return self._full_name < other._full_name

    # ---- Реализация абстрактных методов ----
    def get_info(self) -> str:
        return f"{self._full_name} | {self._age} лет | {self._diagnosis}"

    def to_dict(self) -> dict:
        return {
            "id": self._id,
            "full_name": self._full_name,
            "phone": self._phone,
            "age": self._age,
            "diagnosis": self._diagnosis,
        }

    # ---- Методы класса ----
    @staticmethod
    def validate_phone(phone: str) -> bool:
        digits = "".join(filter(str.isdigit, phone))
        return len(digits) >= 10


