# КАСТОМНЫЙ КЛАСС ДЛЯ МАППИНГА (вместо dict)
# ============================================================

class CustomMap:
    """Кастомный класс-маппинг (замена dict)"""

    def __init__(self):
        self._keys = []
        self._values = []

    def set(self, key, value):
        if key in self._keys:
            index = self._keys.index(key)
            self._values[index] = value
        else:
            self._keys.append(key)
            self._values.append(value)

    def get(self, key, default=None):
        if key in self._keys:
            return self._values[self._keys.index(key)]
        return default

    def remove(self, key):
        if key in self._keys:
            index = self._keys.index(key)
            self._keys.pop(index)
            self._values.pop(index)

    def keys(self):
        return self._keys.copy()

    def values(self):
        return self._values.copy()

    def items(self):
        return list(zip(self._keys, self._values))

    def __len__(self):
        return len(self._keys)

    def __repr__(self):
        return f"CustomMap({dict(zip(self._keys, self._values))})"

    def __str__(self):
        return str(dict(zip(self._keys, self._values)))

    def __eq__(self, other):
        if not isinstance(other, CustomMap):
            return NotImplemented
        return self.items() == other.items()

    def __contains__(self, key):
        return key in self._keys


