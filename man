        self.geometry("400x300")
        self.resizable(False, False)
        self.configure(bg="#f0f0f0")
        self.grab_set()

        self._callback = callback
        self._product = product

        self._build_ui()
        self._center_window(parent)

        if product:
            self._fill_fields()

    def _build_ui(self):
        frame = tk.Frame(self, bg="#f0f0f0", padx=20, pady=20)
        frame.pack(fill=tk.BOTH, expand=True)

        tk.Label(frame, text="Название:", bg="#f0f0f0").grid(row=0, column=0, sticky="e", pady=8)
        self._name_entry = tk.Entry(frame, width=25)
        self._name_entry.grid(row=0, column=1, pady=8)

        tk.Label(frame, text="Цена:", bg="#f0f0f0").grid(row=1, column=0, sticky="e", pady=8)
        self._price_entry = tk.Entry(frame, width=25)
        self._price_entry.grid(row=1, column=1, pady=8)

        tk.Label(frame, text="Количество:", bg="#f0f0f0").grid(row=2, column=0, sticky="e", pady=8)
        self._qty_entry = tk.Entry(frame, width=25)
        self._qty_entry.grid(row=2, column=1, pady=8)

        tk.Label(frame, text="Категория:", bg="#f0f0f0").grid(row=3, column=0, sticky="e", pady=8)
        self._category_combo = ttk.Combobox(
            frame,
            values=["Электроника", "Аксессуары", "Аудио", "Периферия", "Носители"],
            width=23,
            state="readonly"
        )
        self._category_combo.grid(row=3, column=1, pady=8)
        self._category_combo.current(0)

        btn_frame = tk.Frame(frame, bg="#f0f0f0")
        btn_frame.grid(row=4, column=0, columnspan=2, pady=20)

        tk.Button(
            btn_frame, text="Сохранить", command=self._save,
            bg="#2ecc71", fg="white", width=12, relief=tk.FLAT
        ).pack(side=tk.LEFT, padx=5)

        tk.Button(
            btn_frame, text="Отмена", command=self.destroy,
            bg="#95a5a6", fg="white", width=12, relief=tk.FLAT
        ).pack(side=tk.LEFT, padx=5)

    def _fill_fields(self):
        self._name_entry.insert(0, self._product.name)
        self._price_entry.insert(0, str(self._product.price))
        self._qty_entry.insert(0, str(self._product.quantity))
        self._category_combo.set(self._product.category)

    def _save(self):
        name = self._name_entry.get().strip()
        price_text = self._price_entry.get().strip()
        qty_text = self._qty_entry.get().strip()
        category = self._category_combo.get()

        if not name or not price_text or not qty_text:
            messagebox.showwarning("Ошибка", "Заполните все поля!", parent=self)
            return

        try:
            price = float(price_text)
            qty = int(qty_text)
        except ValueError:
            messagebox.showwarning("Ошибка", "Некорректные числовые значения!", parent=self)
            return

        if price < 0 or qty < 0:
            messagebox.showwarning("Ошибка", "Значения не могут быть отрицательными!", parent=self)
            return

        if self._product:
            self._callback(name, price, qty, category, self._product.entity_id)
        else:
            self._callback(name, price, qty, category)

        self.destroy()

    def _center_window(self, parent):
        self.update_idletasks()
        w = self.winfo_width()
        h = self.winfo_height()
        px = parent.winfo_x()
        py = parent.winfo_y()
        pw = parent.winfo_width()
        ph = parent.winfo_height()
        x = px + (pw - w) // 2
        y = py + (ph - h) // 2
        self.geometry(f"{w}x{h}+{x}+{y}")


