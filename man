# ============================================================
# АБСТРАКТНЫЙ БАЗОВЫЙ КЛАСС
# ============================================================

class BaseEntity(ABC):
    """Абстрактный базовый класс для всех сущностей"""

    def __init__(self, entity_id: int):
        self._id = entity_id

    @property
    def entity_id(self):
        return self._id

    @entity_id.setter
    def entity_id(self, value):
        self._id = value

    @abstractmethod
    def get_info(self) -> str:
        pass

    @abstractmethod
    def to_dict(self) -> dict:
        pass

    def __eq__(self, other):
        if not isinstance(other, BaseEntity):
            return NotImplemented
        return self._id == other._id

    def __hash__(self):
        return hash(self._id)

    def __repr__(self):
        return f"{self.__class__.__name__}(id={self._id})"

    def __str__(self):
        return self.get_info()


# ============================================================
# ПОЛЬЗОВАТЕЛЬСКИЙ КЛАСС: User
# ============================================================

class User(BaseEntity):
    """Класс пользователя"""

    def __init__(self, entity_id: int, login: str, password: str, role: str = "user"):
        super().__init__(entity_id)
        self._login = login
        self._password = password
        self._role = role
        self._time_in = None
        self._time_out = None

    # ---- Геттеры и сеттеры ----
    @property
    def login(self):
        return self._login

    @login.setter
    def login(self, value):
        self._login = value

    @property
    def password(self):
        return self._password

    @password.setter
    def password(self, value):
        self._password = value

    @property
    def role(self):
        return self._role

    @role.setter
    def role(self, value):
        self._role = value

    @property
    def time_in(self):
        return self._time_in

    @time_in.setter
    def time_in(self, value):
        self._time_in = value

    @property
    def time_out(self):
        return self._time_out

    @time_out.setter
    def time_out(self, value):
        self._time_out = value

    # ---- Переопределение специальных методов ----
    def __eq__(self, other):
        if not isinstance(other, User):
            return NotImplemented
        return self._login == other._login

    def __hash__(self):
        return hash(self._login)

    def __repr__(self):
        return f"User(login={self._login!r}, role={self._role!r})"

    def __str__(self):
        return f"Пользователь: {self._login} ({self._role})"

    def __lt__(self, other):
        if not isinstance(other, User):
            return NotImplemented
        return self._login < other._login

    # ---- Реализация абстрактных методов ----
    def get_info(self) -> str:
        return f"Пользователь: {self._login} | Роль: {self._role}"

    def to_dict(self) -> dict:
        return {
            "id": self._id,
            "login": self._login,
            "role": self._role,
            "time_in": self._time_in,
            "time_out": self._time_out,
        }

    # ---- Методы класса ----
    @staticmethod
    def validate_login(login: str) -> bool:
        return len(login) >= 3 and login.isalnum()

    @staticmethod
    def validate_password(password: str) -> bool:
        return len(password) >= 4


# ============================================================
# ПОЛЬЗОВАТЕЛЬСКИЙ КЛАСС: Product
# ============================================================

class Product(BaseEntity):
    """Класс товара"""

    def __init__(self, entity_id: int, name: str, price: float, quantity: int, category: str):
        super().__init__(entity_id)
        self._name = name
        self._price = price
        self._quantity = quantity
        self._category = category

    # ---- Геттеры и сеттеры ----
    @property
    def name(self):
        return self._name

    @name.setter
    def name(self, value):
        self._name = value

    @property
    def price(self):
        return self._price

    @price.setter
    def price(self, value):
        if value < 0:
            raise ValueError("Цена не может быть отрицательной")
        self._price = value

    @property
    def quantity(self):
        return self._quantity

    @quantity.setter
    def quantity(self, value):
        self._quantity = value

    @property
    def category(self):
        return self._category

    @category.setter
    def category(self, value):
        self._category = value

    @property
    def total_cost(self):
        return self._price * self._quantity

    # ---- Переопределение специальных методов ----
    def __eq__(self, other):
        if not isinstance(other, Product):
            return NotImplemented
        return self._name == other._name and self._category == other._category

    def __hash__(self):
        return hash((self._name, self._category))

    def __repr__(self):
        return f"Product(name={self._name!r}, price={self._price}, qty={self._quantity})"

    def __str__(self):
        return f"{self._name} — {self._price} руб. (x{self._quantity})"

    def __lt__(self, other):
        if not isinstance(other, Product):
            return NotImplemented
        return self._price < other._price

    def __add__(self, other):
        if not isinstance(other, Product):
            return NotImplemented
        return self.total_cost + other.total_cost

    # ---- Реализация абстрактных методов ----
    def get_info(self) -> str:
        return f"{self._name} | {self._category} | {self._price} руб. | {self._quantity} шт."

    def to_dict(self) -> dict:
        return {
            "id": self._id,
            "name": self._name,
            "price": self._price,
            "quantity": self._quantity,
            "category": self._category,
        }

    # ---- Методы класса ----
    @staticmethod
    def calculate_discount(price: float, discount_percent: float) -> float:
        return round(price * (1 - discount_percent / 100), 2)


