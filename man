    # ---- Центрирование окна ----
    def _center_window(self):
        self.update_idletasks()
        w = self.winfo_width()
        h = self.winfo_height()
        sw = self.winfo_screenwidth()
        sh = self.winfo_screenheight()
        x = (sw - w) // 2
        y = (sh - h) // 2
        self.geometry(f"{w}x{h}+{x}+{y}")

    # ---- Авторизация ----
    def _login(self):
        login = self._login_entry.get().strip()
        password = self._password_entry.get().strip()

        if not login or not password:
            messagebox.showwarning("Ошибка", "Введите логин и пароль!")
            return

        for user in self._users:
            if user.login == login and user.password == password:
                self._current_user = user
                user.time_in = datetime.now()
                self._status_label.config(
                    text=f"Авторизован: {user.login} | Роль: {user.role}",
                    fg="#27ae60"
                )
                self._login_btn.config(state=tk.DISABLED)
                self._logout_btn.config(state=tk.NORMAL)
                self._login_entry.delete(0, tk.END)
                self._password_entry.delete(0, tk.END)
                messagebox.showinfo("Успех", f"Добро пожаловать, {user.login}!")
                return

        messagebox.showerror("Ошибка", "Неверный логин или пароль!")

    # ---- Выход из системы ----
    def _logout(self):
        if self._current_user:
            self._current_user.time_out = datetime.now()
            self._status_label.config(text="Не авторизован", fg="#7f8c8d")
            self._login_btn.config(state=tk.NORMAL)
            self._logout_btn.config(state=tk.DISABLED)
            self._current_user = None

    # ---- Обновление таблицы ----
    def _refresh_table(self):
        for row in self._tree.get_children():
            self._tree.delete(row)

        category = self._category_var.get()
        min_price = self._get_float(self._min_price_entry.get())
        max_price = self._get_float(self._max_price_entry.get())

        total_sum = 0
        count = 0

        for product in self._products:
            if category != "Все" and product.category != category:
                continue
            if min_price is not None and product.price < min_price:
                continue
            if max_price is not None and product.price > max_price:
                continue

            self._tree.insert("", tk.END, values=(
                product.entity_id,
                product.name,
                product.category,
                f"{product.price:.2f}",
                product.quantity,
                f"{product.total_cost:.2f}"
            ))
            total_sum += product.total_cost
            count += 1

        self._stats_label.config(
            text=f"Показано товаров: {count} | Общая стоимость: {total_sum:.2f} руб."
        )

    # ---- Сброс фильтра ----
    def _reset_filter(self):
        self._category_var.set("Все")
        self._min_price_entry.delete(0, tk.END)
        self._max_price_entry.delete(0, tk.END)
        self._refresh_table()

    # ---- Вспомогательный метод ----
    @staticmethod
    def _get_float(text: str):
        try:
            return float(text)
        except (ValueError, TypeError):
            return None

    # ---- Добавление товара ----
    def _add_product(self):
        if not self._current_user:
            messagebox.showwarning("Внимание", "Сначала авторизуйтесь!")
            return

        ProductDialog(self, self._on_product_added)

    def _on_product_added(self, name, price, quantity, category):
        new_id = max((p.entity_id for p in self._products), default=0) + 1
        product = Product(new_id, name, price, quantity, category)
        self._products.append(product)
        self._product_map.set(new_id, product)
        self._refresh_table()

    # ---- Редактирование товара ----
    def _edit_product(self):
        if not self._current_user:
            messagebox.showwarning("Внимание", "Сначала авторизуйтесь!")
            return

        selected = self._tree.selection()
        if not selected:
            messagebox.showwarning("Внимание", "Выберите товар для редактирования!")
            return

        item = self._tree.item(selected[0])
        product_id = item["values"][0]
        product = self._product_map.get(product_id)

        if product:
            ProductDialog(self, self._on_product_edited, product)

    def _on_product_edited(self, name, price, quantity, category, product_id=None):
        product = self._product_map.get(product_id)
        if product:
            product.name = name
            product.price = price
            product.quantity = quantity
            product.category = category
            self._refresh_table()

    # ---- Удаление товара ----
    def _delete_product(self):
        if not self._current_user:
            messagebox.showwarning("Внимание", "Сначала авторизуйтесь!")
            return

        selected = self._tree.selection()
        if not selected:
            messagebox.showwarning("Внимание", "Выберите товар для удаления!")
            return

        item = self._tree.item(selected[0])
        product_id = item["values"][0]
        product = self._product_map.get(product_id)

        if product and messagebox.askyesno("Подтверждение", f"Удалить товар «{product.name}»?"):
            self._products.remove(product)
            self._product_map.remove(product_id)
            self._refresh_table()

    # ---- Сохранение отчёта при закрытии ----
    def _on_close(self):
        if self._current_user and self._current_user.time_out is None:
            self._current_user.time_out = datetime.now()

        try:
            with open("report.txt", "w", encoding="utf-8") as f:
                f.write("+------------------------------------+\n")
                f.write("| login    | time_in            | time_out           |\n")
                f.write("|----------|--------------------|--------------------|\n")

                fmt = "%d.%m.%Y %H:%M:%S"
                for user in self._users:
                    if user.time_in:
                        time_in = user.time_in.strftime(fmt)
                        time_out = user.time_out.strftime(fmt) if user.time_out else "—"
                        f.write(f"| {user.login:<8} | {time_in:<18} | {time_out:<18} |\n")

                f.write("+------------------------------------+\n")
        except Exception as e:
            print(f"Ошибка сохранения отчёта: {e}")

        self.destroy()


